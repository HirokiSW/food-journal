<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="126dp"
    android:layout_height="160dp">

    <ImageView
        android:id="@+id/recentImageViewPicture"
        android:layout_width="110dp"
        android:layout_height="110dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:srcCompat="@tools:sample/avatars" />

    <TextView
        android:id="@+id/recentTextViewName"
        android:layout_width="110dp"
        android:layout_height="wrap_content"
        android:text="item name"
        android:textAlignment="center"
        app:layout_constraintEnd_toEndOf="@+id/recentImageViewPicture"
        app:layout_constraintStart_toStartOf="@+id/recentImageViewPicture"
        app:layout_constraintTop_toBottomOf="@+id/recentImageViewPicture" />

</androidx.constraintlayout.widget.ConstraintLayout>