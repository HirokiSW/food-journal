<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".authorization.MainActivity">

    <TextView
        android:id="@+id/mainTextViewLogin"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="100dp"
        android:text="LOGIN"
        android:textSize="34sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0" />

    <EditText
        android:id="@+id/mainEditTextUsername"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="72dp"
        android:ems="10"
        android:hint="Username"
        android:inputType="text"
        android:minHeight="48dp"
        app:layout_constraintEnd_toEndOf="@+id/mainTextViewLogin"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="@+id/mainTextViewLogin"
        app:layout_constraintTop_toBottomOf="@+id/mainTextViewLogin" />

    <TextView
        android:id="@+id/mainTextViewUsername"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Username:"
        app:layout_constraintBottom_toTopOf="@+id/mainEditTextUsername"
        app:layout_constraintStart_toStartOf="@+id/mainEditTextUsername" />

    <EditText
        android:id="@+id/mainEditTextPassword"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="36dp"
        android:ems="10"
        android:hint="Password"
        android:inputType="textPassword"
        android:minHeight="48dp"
        app:layout_constraintEnd_toEndOf="@+id/mainEditTextUsername"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="@+id/mainEditTextUsername"
        app:layout_constraintTop_toBottomOf="@+id/mainEditTextUsername" />

    <TextView
        android:id="@+id/mainTextViewPassword"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Password:"
        app:layout_constraintBottom_toTopOf="@+id/mainEditTextPassword"
        app:layout_constraintStart_toStartOf="@+id/mainEditTextPassword" />

    <CheckBox
        android:id="@+id/mainCheckBoxRemember"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:text="Remember me"
        app:layout_constraintStart_toStartOf="@+id/mainEditTextPassword"
        app:layout_constraintTop_toBottomOf="@+id/mainEditTextPassword" />

    <Button
        android:id="@+id/mainButtonSignin"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="96dp"
        android:text="SIGN IN"
        app:layout_constraintEnd_toEndOf="@+id/mainEditTextPassword"
        app:layout_constraintStart_toStartOf="@+id/mainEditTextPassword"
        app:layout_constraintTop_toBottomOf="@+id/mainEditTextPassword" />

    <Button
        android:id="@+id/mainButtonAdmin"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="ADMIN"
        app:layout_constraintEnd_toEndOf="@+id/mainButtonSignin"
        app:layout_constraintStart_toStartOf="@+id/mainButtonSignin"
        app:layout_constraintTop_toBottomOf="@+id/mainButtonSignin" />

    <Button
        android:id="@+id/mainButtonClear"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="CLEAR"
        app:layout_constraintEnd_toEndOf="@+id/mainButtonAdmin"
        app:layout_constraintStart_toStartOf="@+id/mainButtonAdmin"
        app:layout_constraintTop_toBottomOf="@+id/mainButtonAdmin" />

</androidx.constraintlayout.widget.ConstraintLayout>